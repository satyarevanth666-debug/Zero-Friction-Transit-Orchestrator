# ==============================================================================
# ZERO-FRICTION TRANSIT ORCHESTRATOR - ENVIRONMENT CONFIGURATION
# ==============================================================================

# Application Environment (development, staging, production)
APP_ENV=development

# Database Connection URL (SQLite for local dev, PostgreSQL for production)
DATABASE_URL=sqlite:///./zero_friction_transit.db

# Authentication Security Secrets
# MUST be 32+ characters in production
JWT_SECRET=development_secret_key_must_be_over_32_characters_long_for_security
ACCESS_TOKEN_MINUTES=15
REFRESH_TOKEN_DAYS=7
COOKIE_SECURE=false

# Allowed Frontend Origins (CORS & CSRF verification)
FRONTEND_ORIGIN=http://localhost:3000

# SMTP Email Configuration (Leave empty to use in-memory Console Mailer in dev)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=noreply@zerofrictiontransit.local

# Local / Self-hosted LLM (Ollama) Settings
OLLAMA_BASE_URL=http://localhost:11434
LLM_MODEL=qwen2.5:7b-instruct
LLM_ENABLED=true
LLM_TIMEOUT_SECONDS=8

# Optional Third-Party Auth & APIs (Disabled by default)
ENABLE_GOOGLE_OAUTH=false
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# External Transit APIs (Flagged off by default; missing data stays honest NULL)
ENABLE_THIRD_PARTY_RAIL=false
RAIL_API_KEY=

# Flight Data Providers (e.g. airlabs, aerodatabox, or mock)
FLIGHT_PROVIDER=mock
FLIGHT_API_KEY=

# Localization & Default Travel Windows
TIMEZONE=Asia/Kolkata
DEFAULT_EVENING_START=16:00
DEFAULT_EVENING_END=21:00
DOMESTIC_CHECKIN_BUFFER_MIN=90

# Frontend Next.js Public Endpoint
NEXT_PUBLIC_API_URL=http://localhost:8000/api
